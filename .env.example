# ==============================================================================
# NEEDIN AI WHATSAPP AUTOMATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' or '.env.production' and fill in the production secrets.
# NEVER commit your real '.env' file or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, 'development' for local work
NODE_ENV="production"
PORT=3000

# Canonical Public Domain URL (used for Razorpay callback, webhook routing & WhatsApp links)
# Production example: https://needin.in or https://app.needin.com
# Local development:  http://localhost:3000
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (PRISMA ORM)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard → Settings → Database → Connection String

# RUNTIME POOLED URL (PgBouncer, Transaction Mode, Port 6543)
# Used by Next.js serverless functions and high-concurrency API routes.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# DIRECT SESSION URL (Direct / Session Mode, Port 5432)
# Required by Prisma CLI for running schema migrations, pushes, and seeds.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=15"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT / SESSIONS)
# ------------------------------------------------------------------------------
# Cryptographically random string (min 32 characters, recommended 64-char hex)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-high-entropy-64-character-hex-secret-here"

# ------------------------------------------------------------------------------
# 4. META WHATSAPP CLOUD API (PRODUCTION INTEGRATION)
# ------------------------------------------------------------------------------
# Documentation: https://developers.facebook.com/docs/whatsapp/cloud-api
# Meta App Dashboard → WhatsApp → API Setup & Business Settings

# Permanent System User Token with 'whatsapp_business_messaging' permission
# Do NOT use a temporary 24-hour test token in production!
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx...permanent_system_user_token"

# Phone Number ID (from Meta Dashboard → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID="100987654321098"

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID="100123456789012"

# Webhook Verification Token (custom secret string you specify in Meta App Dashboard)
# Generate via: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verification_token_here"

# Meta App Secret (App Dashboard → Settings → Basic → App Secret)
# Used to verify SHA256 HMAC signature of incoming WhatsApp webhooks
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# WhatsApp Cloud API Version
WHATSAPP_API_VERSION="v21.0"

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (LIVE PAYMENTS)
# ------------------------------------------------------------------------------
# Dashboard: https://dashboard.razorpay.com/app/keys
# Production: rzp_live_xxxxxxxxxxxxxxxx
# Staging/Test: rzp_test_xxxxxxxxxxxxxxx
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_live_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_key"

# Aliases for backward compatibility
PAYMENT_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
PAYMENT_KEY_SECRET="your_razorpay_live_secret_key"
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret_key"

# ------------------------------------------------------------------------------
# 6. AI PROVIDER (GOOGLE GEMINI PRO / FLASH)
# ------------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
AI_PROVIDER="gemini"
AI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# 7. BUSINESS DEFAULT SETTINGS
# ------------------------------------------------------------------------------
DEFAULT_BUSINESS_NAME="Needin Pet Resort & Day Care"
DEFAULT_BUSINESS_PHONE="+91 98765 43210"
DEFAULT_BUSINESS_ADDRESS="Plot 42, Paw Paradise Lane, Indiranagar, Bengaluru"
DEFAULT_CURRENCY="INR"
